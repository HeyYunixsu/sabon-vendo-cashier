vendorId=
machineId=1
TRANSACTION_DIR=/home/pi/sabon_express_dispenser/transaction

# --- Socket server (coin_slot C++ controller) ---
SOCKET_IP = "127.0.0.1"
SOCKET_PORT = 8080

# --- Cloud API ---
API_BASE_URL = "https://office.dynamicglobalsoft.com:1232"

# --- coin_slot runtime ---
PUMP_START_COOLDOWN_MS = 200

# --- Product calibration ---
# Format: (coins, durationSeconds)
# coins          — number of coins required per dispense cycle
# durationSeconds — how long the pump runs per dispense cycle
calibrateProduct1 = (5, 2.777778)
calibrateProduct2 = (5, 1.3636364)
calibrateProduct3 = (5, 1.25)
calibrateProduct4 = (5, 2.0)

# --- Hardware pin assignments (BCM numbering) ---
# Button input pins (dispense triggers)
BTN1 = 14
BTN2 = 24
BTN3 = 25
BTN4 = 10

# Pump output pins
PUMP1 = 15
PUMP2 = 16
PUMP3 = 6
PUMP4 = 17

# Stop/pause button pin
PIN_STOP = 27

# Pump relay trigger levels (active-low relay: LOW=0 turns pump ON, HIGH=1 turns it OFF)
PUMP_TRIGGER_HIGH = 0
PUMP_TRIGGER_LOW = 1

# --- LED output pins (BCM numbering, one per product slot) ---
# Each LED lights up when its corresponding product slot is armed (has credit).
# Only slots 1-4 are physically wired; 5-6 are reserved for future expansion.
LED1 = 5
LED2 = 6
LED3 = 12
LED4 = 13
# LED5 = (reserved for future slot 5)
# LED6 = (reserved for future slot 6)

# --- Water level sensor pins (BCM numbering) ---
# Used by uploaderTransaction/water_level_monitoring_v2.py
WATER_GPIO_PIN_1 = 26
WATER_GPIO_PIN_2 = 20
WATER_GPIO_PIN_3 = 21
WATER_GPIO_PIN_4 = 11

# --- LED / streetlight schedule (usb_to_coin_module/simple_on_off_led_relay.py) ---
LED_PIN = 18
LED_ON_HOUR = 17
LED_OFF_HOUR = 6
# Relay trigger levels: 0 = GPIO.LOW, 1 = GPIO.HIGH
LED_ON_STATE = 0
LED_OFF_STATE = 1
