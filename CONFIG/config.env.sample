vendorId=
machineId=1
TRANSACTION_DIR=/home/dgsi/Desktop/sabon_vendo_cashier/transaction

# --- Socket server ---
SOCKET_IP = "127.0.0.1"
SOCKET_PORT = 8080

# --- Cashier dashboard ---
# HTTP port for the web dashboard. 80 lets cashiers reach it at a bare
# http://<pi-ip>/ but needs root to bind, which is why PM2 runs it via sudo.
DASHBOARD_PORT = 80

# --- Cloud API ---
API_BASE_URL = "https://office.dynamicglobalsoft.com:1232"

# --- Runtime ---
PUMP_START_COOLDOWN_MS = 200

# --- Product calibration (6 products) ---
calibrateProduct1 = (5, 2.777778)
calibrateProduct2 = (5, 1.3636364)
calibrateProduct3 = (5, 1.25)
calibrateProduct4 = (5, 2.0)
calibrateProduct5 = (5, 2.0)
calibrateProduct6 = (5, 2.0)

# --- 6-slot pin map (BCM) ---
BTN1 = 14
BTN2 = 24
BTN3 = 25
BTN4 = 10
BTN5 = 13
BTN6 = 23

PUMP1 = 15
PUMP2 = 16
PUMP3 = 6
PUMP4 = 17
PUMP5 = 18
PUMP6 = 12

LED1 = 5
LED2 = 27
LED3 = 4
LED4 = 22
LED5 = 19
LED6 = 7

PUMP_TRIGGER_HIGH = 0
PUMP_TRIGGER_LOW = 1

# --- Water level sensors (one per slot) ---
