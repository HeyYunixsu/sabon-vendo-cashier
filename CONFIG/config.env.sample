vendorId=
machineId=1
TRANSACTION_DIR=/home/pi/sabon_express_dispenser/transaction

# --- Slot display names (used by iot_dispenser_v2 GUI) ---
# \n inserts a line break in the display label
slotName1 = "Deesh\nPremium"
slotName2 = "Lanz\nBlossom"
slotName3 = "Lanz\nDainty"
slotName4 = "Switch"

slotColor1 = (100, 224, 25)
slotColor2 = (251, 95, 252)
slotColor3 = (48, 92, 222)
slotColor4 = (144, 213, 255)

# --- Socket server (coin_slot C++ controller) ---
SOCKET_IP = "127.0.0.1"
SOCKET_PORT = 8080

# --- Cloud API ---
API_BASE_URL = "https://office.dynamicglobalsoft.com:1232"

# --- coin_slot runtime ---
MAX_COIN_CREDIT = 1000
PUMP_START_COOLDOWN_MS = 200

# --- Product calibration ---
# Format: (coins, durationSeconds)
# coins          — number of coins required per dispense cycle
# durationSeconds — how long the pump runs per dispense cycle
calibrateProduct1 = (5, 2.777778)
calibrateProduct2 = (5, 1.3636364)
calibrateProduct3 = (5, 1.25)
calibrateProduct4 = (5, 2.0)

# --- Hardware pin assignments (BCM numbering) ---
# Button input pins (coin/dispense triggers)
BTN1 = 14
BTN2 = 24
BTN3 = 25
BTN4 = 10

# Pump output pins
PUMP1 = 15
PUMP2 = 16
PUMP3 = 6
PUMP4 = 17

# Stop/pause button pin
PIN_STOP = 27

# Pump relay trigger levels (active-low relay: LOW=0 turns pump ON, HIGH=1 turns it OFF)
PUMP_TRIGGER_HIGH = 0
PUMP_TRIGGER_LOW = 1

# --- Water level sensor pins (BCM numbering) ---
# Used by uploaderTransaction/water_level_monitoring_v2.py
WATER_GPIO_PIN_1 = 26
WATER_GPIO_PIN_2 = 20
WATER_GPIO_PIN_3 = 21
WATER_GPIO_PIN_4 = 11

# --- Serial coin acceptor (usb_to_coin_module/coin_counter.py) ---
SERIAL_PORT = '/dev/ttyACM0'
BAUD_RATE = 9600

# --- LED / streetlight schedule (usb_to_coin_module/simple_on_off_led_relay.py) ---
LED_PIN = 18
LED_ON_HOUR = 17
LED_OFF_HOUR = 6
# Relay trigger levels: 0 = GPIO.LOW, 1 = GPIO.HIGH
LED_ON_STATE = 0
LED_OFF_STATE = 1
