vendorId=
machineId=1
TRANSACTION_DIR=/home/dgsi/Desktop/sabon_vendo_cashier/transaction

# --- Socket server ---
SOCKET_IP = "127.0.0.1"
SOCKET_PORT = 8080

# --- Cashier dashboard ---
# HTTP port for the web dashboard. 80 lets cashiers reach it at a bare
# http://<pi-ip>/ but needs root to bind, which is why PM2 runs it via sudo.
DASHBOARD_PORT = 80
# PIN required to use the dashboard API. Without it, anyone who can reach this
# machine's IP can arm a slot and dispense product for free. Leave blank to
# disable the check (not recommended on a shared network). Cashiers type it
# once per device; it is remembered in the browser.
DASHBOARD_PIN = 1234
# Recovery code for the dashboard's "Forgot PIN?" flow. The OWNER holds this and
# reads it out over the phone -- never the cashier, and never written near the
# machine. Entering it reveals the current PIN, so a lockout is solved remotely
# instead of by a site visit. Make it long: 12+ random characters. Blank removes
# the "Forgot PIN?" link entirely. Rate limited to 5 tries per device, then a
# 15 minute lockout.
DASHBOARD_RECOVERY_CODE = change-me-to-something-long

# --- Cloud API ---
API_BASE_URL = "https://office.dynamicglobalsoft.com:1232"

# --- Runtime ---
PUMP_START_COOLDOWN_MS = 200

# --- Product calibration (6 products) ---
calibrateProduct1 = (5, 2.777778)
calibrateProduct2 = (5, 1.3636364)
calibrateProduct3 = (5, 1.25)
calibrateProduct4 = (5, 2.0)
calibrateProduct5 = (5, 2.0)
calibrateProduct6 = (5, 2.0)

# --- 6-slot pin map (BCM) ---
BTN1 = 14
BTN2 = 24
BTN3 = 25
BTN4 = 10
BTN5 = 13
BTN6 = 23

PUMP1 = 15
PUMP2 = 16
PUMP3 = 6
PUMP4 = 17
PUMP5 = 18
PUMP6 = 12

LED1 = 5
LED2 = 27
LED3 = 4
LED4 = 22
LED5 = 19
LED6 = 7

PUMP_TRIGGER_HIGH = 0
PUMP_TRIGGER_LOW = 1

# Which level a water level sensor reports when its slot is EMPTY.
#   1 = empty reads HIGH (default)
#   0 = empty reads LOW
# Sensors are wired GPIO -> GND with a pull-up, so a disconnected sensor reads
# HIGH. The default fails safe: a dead sensor looks empty and the pump is
# blocked rather than left to run dry. If a full slot reports empty on real
# hardware, set this to 0 and restart 01_Dispenser_Controller -- no rebuild needed.
WATER_SENSOR_EMPTY_HIGH = 1

# --- Water level sensors (one per slot) ---
WATER_GPIO_PIN_1 = 26
WATER_GPIO_PIN_2 = 20
WATER_GPIO_PIN_3 = 21
WATER_GPIO_PIN_4 = 11
WATER_GPIO_PIN_5 = 8
WATER_GPIO_PIN_6 = 9
